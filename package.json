{
  "name": "kg",
  "version": "1.0.0",
  "description": "Интерактивная карта лыжной трассы",
  "type": "module",
  "scripts": {
    "dev": "npm run build:tracks && vite",
    "build": "npm run build:tracks && tsc --noEmit && vite build",
    "build:tracks": "node scripts/build-tracks.mjs",
    "preview": "vite preview",
