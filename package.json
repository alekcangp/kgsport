    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.3",
    "@turf/turf": "^7.1.0",
    "@types/qrcode": "^1.5.6",
    "jszip": "^3.10.1",
    "maplibre-gl": "^6.16.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.0",
    "pngquant-bin": "^9.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
